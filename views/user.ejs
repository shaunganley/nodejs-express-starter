<%- include ('html_head',{title: 'User Information'})%>
<body>
    <div id="content_matt">
    <%- include('navigation')%>
    <h1>User Information</h1>

    <% if (user) { %>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role %></td>
                </tr>
            </tbody>
        </table>
    <% } else { %>
        <p>No user found.</p>
    <% } %>
</div>
<%- include ('footer')%>
</body>
</html>

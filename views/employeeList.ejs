<!-- US001 - View Employees -->
<%- include ('html_head',{title: 'All Employees'})%>
<body>
    <div id="content_matt">
    <%- include('navigation')%>
    <h1>Employees List</h1>

    <% if (employees && employees.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Employee Number</th>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Role</th>
                    <th>Salary</th>
                </tr>
            </thead>
            <tbody>
                <% employees.forEach(employee => { %>
                    <tr>
                        <td><%= employee.number %></td>
                        <td><%= employee.name %></td>
                        <td><%= employee.address %></td>
                        <td><%= employee.role %></td>
                        <td><%= employee.salary %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <p>No employees found.</p>
    <% } %>
    </div>
    <%- include ('footer')%>
</body>
</html>

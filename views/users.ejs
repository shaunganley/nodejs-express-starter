<%- include ('html_head',{title: 'All Users'})%>
<body>
    <div id="content_matt">
    <%- include('navigation')%>
    <h1>User List</h1>

    <% if (users && users.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                    <tr>
                        <td><%= user.name %></td>
                        <td><%= user.email %></td>
                        <td><%= user.role %></td>
                        <td><a href="/users/<%= user.id %>">View</a></td>
                        <td><a href="/users/update/<%= user.id %>">Edit</a></td>
                        <td><a href="/users/delete/<%= user.id %>">Delete</a></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <p>No users found.</p>
    <% } %>

    <form action="/users/add" method="get">
        <input type="submit" value="Create New User">
    </form> 
</div>
<%- include ('footer')%>
</body>
</html>
